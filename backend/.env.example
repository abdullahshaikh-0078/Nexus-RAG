# Nexus RAG Configuration
APP_NAME=NEXUS RAG
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=nexus_rag_db

# Qdrant Vector Store Configuration
# Leave QDRANT_URL empty to use local disk storage at ./data/qdrant_db
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=nexus_chunks
QDRANT_STORAGE_PATH=./data/qdrant_db

# Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# LLM Provider Configuration
# Supported providers: gemini, groq, mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash
